# Local PostgreSQL (Docker Compose defaults)
POSTGRES_DB=gentlescreen
POSTGRES_USER=gentlescreen
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=jdbc:postgresql://postgres:5432/gentlescreen
DATABASE_USERNAME=gentlescreen
DATABASE_PASSWORD=change-me-for-local-development

# Generate a high-entropy value before enabling authentication.
JWT_SECRET=replace-with-at-least-64-random-characters
YOUTUBE_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
SPRING_PROFILES_ACTIVE=local

# Development-only seed accounts (seeding is added in a later phase).
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-me
SEED_REVIEWER_EMAIL=reviewer@example.invalid
SEED_REVIEWER_PASSWORD=replace-me
SEED_PARENT_EMAIL=parent@example.invalid
SEED_PARENT_PASSWORD=replace-me

# Expo-visible values must never contain secrets.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

